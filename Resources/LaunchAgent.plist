<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent: start TeamsNotifier at login. Installed by Scripts/install-launch-agent.sh -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.teamsnotifier.app</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/TeamsNotifier.app/Contents/MacOS/TeamsNotifier</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/teamsnotifier.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/teamsnotifier.log</string>
</dict>
</plist>
